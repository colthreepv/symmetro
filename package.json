    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "7.3.6",
    "vite-plugin-singlefile": "2.3.3"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.19.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "^11.17.0",
      "onFail": "error"
    }
